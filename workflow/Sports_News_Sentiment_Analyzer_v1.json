    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Capturamos la salida de la IA (Oteador GPT)\nconst item = $input.item.json;\nlet aiData = {};\n\n// 2. Recuperamos la noticia original dinámicamente\nconst noticiaOriginal = $node[\"Limit\"].json;\n\n// 3. Lógica de Fuente\nlet fuente = \"Google News\";\nconst url = (noticiaOriginal.link || \"\").toLowerCase();\nconst title = (noticiaOriginal.title || \"\").toLowerCase();\n\nif (url.includes(\"sport.es\") || title.includes(\"sport\")) fuente = \"Diario SPORT\";\nelse if (url.includes(\"fichajes.net\") || title.includes(\"fichajes\")) fuente = \"Fichajes.net\";\nelse if (url.includes(\"tribuna.com\")) fuente = \"Tribuna.com\";\nelse if (url.includes(\"tycsports\")) fuente = \"TyC Sports\";\n\n// 4. Retorno final: Volvemos al Link original sin HTML\nreturn {\n    Fecha: noticiaOriginal.isoDate,\n    Titulo: noticiaOriginal.title,\n    Fuente: fuente,\n    Sentimiento_Score: $json.output[0].content[0].text.sentimiento,\n    Jugadores_Mencionados: $json.output[0].content[0].text.jugadores,\n    Resumen: $json.output[0].content[0].text.resumen,\n    Link: noticiaOriginal.link\n};"
      },
